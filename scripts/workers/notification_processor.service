[Unit]
Description=ML Notification Processor Worker
After=network.target yunfan.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yunfan-pro-dev
ExecStart=/usr/bin/python3 /home/ubuntu/yunfan-pro-dev/scripts/workers/notification_processor.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/yunfan-pro-dev/notification_processor.log
StandardError=append:/home/ubuntu/yunfan-pro-dev/notification_processor.log

[Install]
WantedBy=multi-user.target
